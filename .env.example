# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
APAGENT_MODEL=claude-sonnet-5-5
APAGENT_BACKEND=sqlite          # sqlite | duckdb | databricks
APAGENT_DB_PATH=data/ap.db
APAGENT_MAX_STEPS=8
# Optional: $ per million tokens, used only for the cost line in the eval report
APAGENT_PRICE_IN_PER_MTOK=0
APAGENT_PRICE_OUT_PER_MTOK=0
# Milestone H (Databricks)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=ap_agent
